PORT=3000

# Para Supabase: postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres?sslmode=require
# Para local: postgresql://postgres:postgres@localhost:5432/nha_kinhon
DATABASE_URL="postgresql://user:password@host:5432/nha_kinhon"

# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# production → sk_live_… ; staging (APP_ENV=staging) → sk_test_… only
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# production | staging | development (default: production if NODE_ENV=production)
APP_ENV="development"

# Optional — omit to disable error reporting
SENTRY_DSN=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

CLIENT_URL="http://localhost:5173"

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
