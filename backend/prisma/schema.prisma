generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  password        String
  phone           String?
  avatar          String?
  balance         Float     @default(0)
  role            Role      @default(USER)
  stripeCustomerId String?
  refreshToken    String?
  locale          String?
  deletedAt       DateTime?
  isBlocked       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cartItems       CartItem[]
  orders          Order[]
  favorites       Favorite[]
  contacts        Contact[]
  paymentMethods  PaymentMethod[]
  notifications   Notification[]
  supporters      Supporter[]
  deliveryProfile DeliveryProfile?
  deliveryOrders  Order[]          @relation("DeliveryOrders")
  pushTokens      PushToken[]
  wallet          Wallet?

  @@index([deletedAt])
  @@map("users")
}

enum Role {
  USER
  ADMIN
  DELIVERY
}

model Market {
  id          String        @id @default(cuid())
  name        String
  type        MarketType
  location    String
  address     String?
  phone       String?
  hours       String
  coordinates Json
  lat         Float?
  lng         Float?
  image       String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  products    Product[]

  @@index([active])
  @@map("markets")
}

enum MarketType {
  MERCADO_LOCAL
  SUPERMERCADO
  TIENDA_ESPECIALIZADA
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  icon      String
  image     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  products  Product[]

  @@index([active])
  @@map("categories")
}

model Product {
  id          String    @id @default(cuid())
  name        String
  description String?
  price       Float
  unit        String
  image       String?
  available   Boolean   @default(true)
  categoryId  String
  marketId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category    Category  @relation(fields: [categoryId], references: [id])
  market      Market    @relation(fields: [marketId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]
  favorites   Favorite[]

  @@index([name])
  @@index([available])
  @@map("products")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("cart_items")
}

model Order {
  id               String       @id @default(cuid())
  userId           String
  status           OrderStatus  @default(PENDING_PAYMENT)
  subtotal         Float
  shipping         Float        @default(0)
  total            Float
  notes            String?
  recipientName    String
  recipientPhone   String?
  recipientAddress String?
  recipientLat     Float?
  recipientLng     Float?
  /// Stripe PaymentIntent id (Payment Sheet) o Checkout Session id (web)
  stripePaymentId  String?
  deliveryId       String?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  deliveryPhoto    String?
  courierNearbyNotifiedAt DateTime?
  /// Intentos fallidos de entrega registrados
  failedDeliveryAttempts Int    @default(0)
  /// Plazo para acciones del comprador tras fallo / no entregable
  buyerResolutionDeadline DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User         @relation(fields: [userId], references: [id])
  delivery         User?        @relation("DeliveryOrders", fields: [deliveryId], references: [id])
  items            OrderItem[]
  deliveryPhotos   OrderDeliveryPhoto[]
  notifications    Notification[]
  deliveryAttempts DeliveryAttempt[]
  orderEvents      OrderEvent[]
  refunds          Refund[]

  @@index([userId])
  @@index([status])
  @@index([deliveryId])
  @@index([stripePaymentId])
  @@map("orders")
}

enum OrderStatus {
  /// Borrador: creado en checkout, aún sin pago Stripe confirmado
  PENDING_PAYMENT
  /// Legacy: tratado como unpaid igual que PENDING_PAYMENT
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  PICKED_UP
  IN_TRANSIT
  /// Intento fallido; puede reprogramarse
  DELIVERY_FAILED_ATTEMPT
  /// No entregable (agotados reintentos o motivo no reintentable)
  UNDELIVERABLE
  DELIVERED
  CANCELLED
  /// Reembolso total completado
  REFUNDED
  /// Reembolso parcial completado
  PARTIALLY_REFUNDED
}

enum DeliveryFailureReason {
  RECIPIENT_ABSENT
  WRONG_ADDRESS
  RECIPIENT_REFUSED
  UNREACHABLE_PHONE
  ACCESS_BLOCKED
  PRODUCT_DAMAGED
  OTHER
}

enum OrderEventType {
  DELIVERY_FAILED
  BUYER_RECIPIENT_UPDATED
  BUYER_REQUEST_REATTEMPT
  BUYER_CANCEL_REQUEST_REFUND
  ADMIN_RESOLVE_UNDELIVERABLE
  REFUND_REQUESTED
  REFUND_APPROVED
  REFUND_REJECTED
  REFUND_STRIPE_CREATED
  REFUND_COMPLETED
  REFUND_FAILED
  ORDER_CANCELLED_AUTO_REFUND
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum RefundReason {
  CANCEL_BEFORE_DISPATCH
  UNDELIVERABLE
  DAMAGED_PRODUCT
  MISSING_PRODUCT
  ADMIN_MANUAL
  OTHER
}

model DeliveryAttempt {
  id           String                @id @default(cuid())
  orderId      String
  attemptNumber Int
  reason       DeliveryFailureReason
  note         String?
  lat          Float?
  lng          Float?
  recordedById String
  createdAt    DateTime              @default(now())

  order        Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photos       OrderDeliveryPhoto[]

  @@index([orderId])
  @@map("delivery_attempts")
}

model OrderEvent {
  id        String         @id @default(cuid())
  orderId   String
  type      OrderEventType
  actorId   String?
  actorRole Role?
  payload   Json?
  createdAt DateTime       @default(now())

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_events")
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  amount          Int
  status          RefundStatus @default(PENDING)
  stripeRefundId  String?
  reason          RefundReason
  requestedById   String?
  approvedById    String?
  rejectedById    String?
  adminNote       String?
  buyerNote       String?
  /// IDs de líneas de pedido para reembolso parcial (OrderItem.id)
  orderItemIds    Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([stripeRefundId])
  @@map("refunds")
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  orderId   String?
  refundId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([orderId])
  @@map("admin_audit_logs")
}

model StripeProcessedEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String
  createdAt DateTime @default(now())

  @@map("stripe_processed_events")
}

model RequestIdempotency {
  id           String   @id @default(cuid())
  scope        String
  key          String
  actorId      String
  orderId      String?
  responseBody Json
  createdAt    DateTime @default(now())

  @@unique([scope, actorId, orderId, key])
  @@index([actorId])
  @@index([orderId])
  @@map("request_idempotency")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Float
  quantity  Int

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("favorites")
}

model Contact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("contacts")
}

model PaymentMethod {
  id          String            @id @default(cuid())
  userId      String
  type        PaymentMethodType
  last4       String?
  expiry      String?
  provider    String?
  phone       String?
  stripeId    String?
  isDefault   Boolean           @default(false)
  createdAt   DateTime          @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

enum PaymentMethodType {
  VISA
  MASTERCARD
  MPESA
  ORANGE_MONEY
}

model Notification {
  id                  String           @id @default(cuid())
  userId              String
  type                NotificationType
  title               String
  message             String
  orderId             String?
  walletTransactionId String?
  withdrawalRequestId String?
  read                Boolean          @default(false)
  createdAt           DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([orderId])
  @@index([walletTransactionId])
  @@index([withdrawalRequestId])
  @@map("notifications")
}

enum NotificationType {
  ORDER_CONFIRMED
  ORDER_PROCESSING
  ORDER_SHIPPED
  ORDER_PICKED_UP
  ORDER_IN_TRANSIT
  ORDER_COURIER_NEARBY
  ORDER_DELIVERED
  ORDER_CANCELLED
  ORDER_DELIVERY_FAILED
  ORDER_UNDELIVERABLE
  ORDER_ASSIGNED_COURIER
  REFUND_REQUESTED
  REFUND_APPROVED
  REFUND_REJECTED
  REFUND_COMPLETED
  REFUND_FAILED
  ADMIN_REFUND_REQUEST
  ADMIN_UNDELIVERABLE
  PAYMENT_RECEIVED
  PROMO
  WALLET_DEPOSIT_RECEIVED
  WALLET_TRANSFER_SENT
  WALLET_TRANSFER_RECEIVED
  WALLET_WITHDRAWAL_APPROVED
  WALLET_WITHDRAWAL_REJECTED
  WALLET_WITHDRAWAL_PAID
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  currency  String   @default("XOF")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]
  transactions WalletTransaction[]

  @@map("wallets")
}

enum LedgerSide {
  DEBIT
  CREDIT
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  ORDER_PAYMENT
  REFUND
  ADJUSTMENT
}

enum LedgerEntryStatus {
  PENDING
  POSTED
  REVERSED
}

model LedgerEntry {
  id                  String            @id @default(cuid())
  walletId            String
  side                LedgerSide
  amountMinor         Int
  entryType           LedgerEntryType
  status              LedgerEntryStatus @default(POSTED)
  reference           String?
  idempotencyKey      String?           @unique
  walletTransactionId String?
  metadata            Json?
  createdAt           DateTime          @default(now())

  wallet            Wallet             @relation(fields: [walletId], references: [id], onDelete: Restrict)
  walletTransaction WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([walletTransactionId])
  @@index([status])
  @@map("ledger_entries")
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_OUT
  TRANSFER_IN
  ORDER_PAYMENT
  REFUND
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

model WalletTransaction {
  id              String                  @id @default(cuid())
  walletId        String
  type            WalletTransactionType
  status          WalletTransactionStatus @default(PENDING)
  amountMinor     Int
  counterpartyWalletId String?
  orderId         String?
  note            String?
  stripePaymentIntentId String?
  idempotencyKey  String?                 @unique
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  wallet           Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  ledgerEntries    LedgerEntry[]
  withdrawalRequest WithdrawalRequest?

  @@index([walletId, createdAt])
  @@index([status])
  @@index([orderId])
  @@map("wallet_transactions")
}

enum WithdrawalMethod {
  MOBILE_MONEY
  BANK
}

enum WithdrawalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

model WithdrawalRequest {
  id                  String                  @id @default(cuid())
  walletTransactionId String                  @unique
  userId              String
  amountMinor         Int
  method              WithdrawalMethod
  destination         Json
  status              WithdrawalRequestStatus @default(PENDING)
  adminNote           String?
  reviewedById        String?
  reviewedAt          DateTime?
  paidAt              DateTime?
  payoutReference     String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  walletTransaction WalletTransaction @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@map("withdrawal_requests")
}

model WalletRequestIdempotency {
  id           String   @id @default(cuid())
  scope        String
  key          String
  actorId      String
  responseBody Json
  createdAt    DateTime @default(now())

  @@unique([scope, actorId, key])
  @@index([actorId])
  @@map("wallet_request_idempotency")
}

model OrderDeliveryPhoto {
  id           String   @id @default(cuid())
  orderId      String
  url          String
  uploadedById String
  deliveryAttemptId String?
  createdAt    DateTime @default(now())

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryAttempt DeliveryAttempt? @relation(fields: [deliveryAttemptId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([deliveryAttemptId])
  @@map("order_delivery_photos")
}

model DeliveryProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone           String
  vehicle         String
  serviceArea     String?
  isActive        Boolean  @default(false)
  totalDeliveries Int      @default(0)
  rating          Float    @default(5.0)
  currentLocation Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("delivery_profiles")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@map("push_tokens")
}

model Supporter {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  message   String
  avatar    String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@map("supporters")
}
